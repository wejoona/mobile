<?xml version="1.0" encoding="utf-8"?>
<!--
    SECURITY: Network Security Configuration
    - Disables cleartext (HTTP) traffic in release builds
    - Enforces HTTPS for all production traffic
    - Certificate pinning for production API

    DEPLOYMENT: Before production release:
    1. Generate certificate pins using:
       openssl s_client -servername korido-api.joonapay.com -connect korido-api.joonapay.com:443 </dev/null 2>/dev/null | \
         openssl x509 -pubkey -noout | \
         openssl pkey -pubin -outform der | \
         openssl dgst -sha256 -binary | \
         openssl enc -base64
    2. Update pins before certificate rotation
    3. Update expiration date before the current pin-set expires
-->
<network-security-config>
    <!-- Base configuration for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Korido production API host with certificate pinning. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">korido-api.joonapay.com</domain>
        <pin-set expiration="2026-09-16">
            <!-- Leaf SPKI SHA-256 for Korido production API, verified 2026-06-20. -->
            <pin digest="SHA-256">DcXImxqsw11wXDKaem3Be3mcFibKSosQGkPpNOw9Zuw=</pin>
            <!-- Google Trust Services WE1 intermediate SPKI backup pin. -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Joonalabs staging uses platform TLS until its Cloudflare certificate is live and pinned. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.joonalabs.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- JoonaPay apex host with its own pin set. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">joonapay.com</domain>
        <pin-set expiration="2026-08-04">
            <!-- Leaf SPKI SHA-256 for joonapay.com, verified 2026-06-20. -->
            <pin digest="SHA-256">dnwFNJb53pgHXDzto90QqivYDXDUKaYHYU7OxVOxgVw=</pin>
            <!-- Previous apex leaf SPKI SHA-256 kept as a rollover pin. -->
            <pin digest="SHA-256">vz/Oj4HDd7i5iGnOiGk+BAZa/i62MKNdA74TWH/6pew=</pin>
            <!-- Google Trust Services WE1 intermediate SPKI backup pin. -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
