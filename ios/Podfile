# Minimum iOS version for Korido.
# Xcode 27 supports iOS deployment targets from 15.0 upward.
platform :ios, '15.0'
inhibit_all_warnings!

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

$FirebaseAnalyticsWithoutAdIdSupport = true

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def append_build_setting(config, key, *values)
  setting = config.build_settings[key] || ['$(inherited)']
  setting = setting.split if setting.is_a?(String)
  values.each do |value|
    setting << value unless setting.include?(value)
  end
  config.build_settings[key] = setting
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  development_team = ENV['DEVELOPMENT_TEAM'] || 'NV4RJ48P6V'
  xcode_upgrade_check = '2700'

  installer.pods_project.root_object.attributes['LastUpgradeCheck'] = xcode_upgrade_check
  installer.pods_project.root_object.attributes['LastSwiftMigration'] = xcode_upgrade_check

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    if target.respond_to?(:source_build_phase) && target.source_build_phase
      target.source_build_phase.files.dup.each do |build_file|
        file_ref = build_file.file_ref
        next unless file_ref&.path&.end_with?('.xcprivacy')

        target.source_build_phase.remove_build_file(build_file)
      end
    end

    target.build_configurations.each do |config|
      config.build_settings['DEVELOPMENT_TEAM'] = development_team
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      config.build_settings['COCOAPODS_PARALLEL_CODE_SIGN'] = 'false'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 x86_64'
      config.build_settings['ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
      config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['LIBRARY_SEARCH_PATHS'] = '$(inherited) $(SDKROOT)/usr/lib/swift'
      append_build_setting(config, 'OTHER_CFLAGS', '-w')
      append_build_setting(config, 'OTHER_SWIFT_FLAGS', '-suppress-warnings')
      definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      definitions << 'PERMISSION_CONTACTS=1' unless definitions.include?('PERMISSION_CONTACTS=1')

      if target.name == 'Sentry'
        swift_flags = config.build_settings['OTHER_SWIFT_FLAGS']
        unless swift_flags.include?('CheckImplementationOnly')
          swift_flags.concat([
            '-enable-experimental-feature',
            'CheckImplementationOnly',
          ])
        end
        config.build_settings['OTHER_SWIFT_FLAGS'] = swift_flags
      end
    end
  end

  Dir[File.join(installer.sandbox.root.to_s, 'Target Support Files', '**', '*.xcconfig')].each do |path|
    contents = File.read(path)
    sanitized = contents
      .gsub(/\s+"?\$\{TOOLCHAIN_DIR\}\/usr\/lib\/swift\/\$\{PLATFORM_NAME\}"?/, '')
      .gsub(/\s+"?\$\(TOOLCHAIN_DIR\)\/usr\/lib\/swift\/\$\(PLATFORM_NAME\)\/?"?/, '')
      .gsub(/\s+"?[^"\s]*Metal\.xctoolchain\/usr\/lib\/swift\/[^"\s]*"?/, '')
      .gsub(/LIBRARY_SEARCH_PATHS =\s+/, 'LIBRARY_SEARCH_PATHS = ')
      .gsub(/[ \t]+\n/, "\n")
    File.write(path, sanitized) if sanitized != contents
  end
end
